# =============================================
# Campus Operations Platform — Environment Variables
# =============================================
# Copy this file to server/.env and fill in values.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campus_ops"

# --- CORS ---
CLIENT_URL="http://localhost:5173"

# --- Frontend API URL (used by Vite) ---
VITE_API_URL="http://localhost:5000/api"

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI Provider (Gemini) ---
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
SIMILARITY_THRESHOLD=0.80

# --- Redis (Sprint 5) ---
REDIS_URL=redis://localhost:6379

# --- BullMQ Job Queue (Sprint 5) ---
AI_QUEUE_NAME=ai-processing
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=5000
